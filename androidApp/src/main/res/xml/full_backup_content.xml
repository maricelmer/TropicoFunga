<?xml version="1.0" encoding="utf-8"?>
<!--
  Equivalente ao data_extraction_rules.xml, mas no schema antigo (Auto Backup
  for Apps), usado pelo Android em API 23-30. A partir da API 31 quem manda e
  o dataExtractionRules.xml (ja configurado). Mesma politica: inclui tudo,
  pois o app nao guarda dado sensivel localmente (catalogo offline; apenas
  preferencias de tema/idioma via multiplatform-settings).
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="database" path="." />
</full-backup-content>
